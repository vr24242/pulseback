generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// SESSION — Required by @shopify/shopify-app-session-storage-prisma
// ─────────────────────────────────────────────────────────────
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────
// SHOP — Multi-tenant root. One record per installed Shopify store.
// ─────────────────────────────────────────────────────────────
model Shop {
  id          String   @id @default(cuid())
  domain      String   @unique  // mystore.myshopify.com
  accessToken String
  name        String?
  email       String?
  currency    String   @default("INR")
  timezone    String   @default("Asia/Kolkata")
  isActive      Boolean   @default(true)
  uninstalledAt DateTime?

  // Integration credentials (encrypted at app layer)
  // WhatsApp — AiSensy (recommended for India)
  aiSensyApiKey       String?
  // WhatsApp — WATI
  watiApiToken        String?
  watiPhoneNumber     String?  // stores WATI API URL for this field
  // WhatsApp — Meta Cloud API
  waPhoneNumberId     String?
  waAccessToken       String?
  waBusinessAccountId String?
  waVerifyToken       String?
  // Email
  sendgridApiKey    String?
  sendgridFromEmail String?
  // Twilio SMS
  twilioAccountSid  String?
  twilioAuthToken   String?
  twilioPhone       String?
  // Meta / Google
  metaPixelId       String?
  metaAccessToken   String?
  // Shiprocket
  shiprocketEmail        String?
  shiprocketToken        String?
  shiprocketJwt          String?   // cached JWT from last auth
  shiprocketJwtExpiresAt DateTime? // JWTs expire in 10 days
  shiprocketWebhookSecret String?  // HMAC secret for webhook signature verification
  shiprocketWebhookId    String?   // Shiprocket webhook registration ID

  // Owner / merchant contact
  ownerPhone        String?  // merchant's WhatsApp for daily briefing
  ownerName         String?

  // Settings
  codEnabled         Boolean @default(true)
  codBlockingEnabled Boolean @default(true)  // when true, hide COD for high-RTO customers
  rtoThreshold       Int     @default(60)    // hide COD above this score (only if blocking enabled)
  dispatchSlaHours   Int     @default(24)
  codFloatAlert      Int     @default(50000) // alert when COD outstanding exceeds this

  // Branding — checkout portal customization
  brandPrimaryColor   String @default("#7c3aed")
  brandSecondaryColor String @default("#6366f1")
  logoUrl             String?
  checkoutFont        String @default("sans-serif")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers        Customer[]
  orders           Order[]
  checkoutSessions CheckoutSession[]
  automations      Automation[]
  communications   Communication[]
  returnRequests   ReturnRequest[]
  promoCodes       PromoCode[]
  loyaltyProgram   LoyaltyProgram?
  bnplPlans        BNPLPlan[]

  @@map("shops")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMER — Identity OS core. The single record per customer.
// ─────────────────────────────────────────────────────────────
model Customer {
  id    String @id @default(cuid())
  shopId String
  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Identity
  phone             String?
  email             String?
  name              String?
  shopifyCustomerId String?
  identityConfidence Float  @default(0) // 0.0 - 1.0

  // Location
  city    String?
  state   String?
  pincode String?
  country String  @default("IN")

  // Acquisition (captured at first checkout)
  acquisitionSource   String?
  acquisitionCampaign String?
  acquisitionMedium   String?
  acquisitionContent  String?
  referredBy          String?  // customerId of referrer
  firstSeenAt         DateTime @default(now())
  lastSeenAt          DateTime @default(now())

  // ── Identity OS Scores ──
  rtoRiskScore Int   @default(0)   // 0-100. >60 = hide COD
  fraudScore   Int   @default(0)   // 0-100. >80 = flag for review
  churnScore   Int   @default(0)   // 0-100. Updated by Retention OS
  ltv          Float @default(0)   // lifetime value in store currency
  ltvTier      String @default("new")
  // new | growing | loyal | vip | lapsed

  // ── Order Stats (denormalized for fast querying) ──
  totalOrders       Int      @default(0)
  totalSpend        Float    @default(0)
  averageOrderValue Float    @default(0)
  lastOrderAt       DateTime?
  expectedNextOrderAt DateTime? // computed by Retention OS

  // ── Return Stats ──
  totalReturns Int   @default(0)
  returnRate   Float @default(0) // 0.0 - 1.0

  // ── Communication Consent ──
  whatsappOptIn Boolean @default(false)
  emailOptIn    Boolean @default(false)
  smsOptIn      Boolean @default(false)
  optInCapturedAt DateTime?

  // ── Engagement Signals ──
  emailOpenRate         Float @default(0)
  whatsappResponseRate  Float @default(0)
  lastEngagedAt         DateTime?
  engagementScore       Int   @default(0) // 0-100

  // ── Lifecycle ──
  lifecycleStage String @default("prospect")
  // prospect | first_buyer | repeat | loyal | vip | at_risk | lapsed

  // ── Next Scheduled Action (Retention OS) ──
  nextActionType    String?
  nextActionAt      DateTime?

  // ── Support History (denormalized) ──
  totalTickets   Int @default(0)
  openTickets    Int @default(0)
  avgCsatScore   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  checkoutSessions CheckoutSession[]
  communications   Communication[]
  supportTickets   SupportTicket[]
  retentionActions RetentionAction[]
  timeline         TimelineEvent[]
  returnRequests   ReturnRequest[]
  savedAddresses   SavedAddress[]
  loyaltyPoints    CustomerLoyaltyPoints?
  agentDecisions   AgentDecision[] // Phase 5: audit trail of all agent decisions
  learningOutcomes LearningOutcome[] // Phase 5: outcomes for learning loop
  agentFeedback    AgentFeedback[] // Phase 5: merchant feedback on decisions

  @@unique([shopId, phone])
  @@unique([shopId, email])
  @@unique([shopId, shopifyCustomerId])
  @@index([shopId, ltvTier])
  @@index([shopId, lifecycleStage])
  @@index([shopId, churnScore])
  @@index([shopId, nextActionAt])
  @@index([shopId, lastOrderAt])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────
// SAVED ADDRESS — Customer's address book for quick checkout
// ─────────────────────────────────────────────────────────────
model SavedAddress {
  id         String @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Address fields
  name       String
  phone      String?
  address1   String
  address2   String?
  city       String
  state      String
  pincode    String
  country    String @default("IN")
  label      String? // "Home", "Office", etc.

  // Metadata
  isDefault  Boolean @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, pincode, address1])  // Prevent duplicate addresses
  @@index([customerId, isDefault])
  @@map("saved_addresses")
}

// ─────────────────────────────────────────────────────────────
// CHECKOUT SESSION — Checkout OS. Every session from first touch.
// ─────────────────────────────────────────────────────────────
model CheckoutSession {
  id       String  @id @default(cuid())
  shopId   String
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])

  // Shopify checkout token (links to their checkout)
  shopifyCheckoutToken String  @unique
  cartValue            Float
  cartItems            Json    // OrderItem[]

  // Identity captured during session
  phone   String?
  email   String?
  pincode String?

  // ── Checkout OS Intelligence ──
  rtoRiskAtCheckout Int?
  codShown          Boolean @default(false)
  discountOffered   String?
  discountApplied   Boolean @default(false)
  upsellProductId   String?  // product shown as upsell
  upsellConverted   Boolean @default(false)

  // ── Promo Code & Loyalty ──
  promoCodeUsed     String?  // code string
  promoDiscountAmount Int? // discount applied in ₹ paise
  loyaltyPointsRedeemed Int? // points redeemed for discount
  loyaltyDiscountAmount Int? // discount from loyalty points

  // ── BNPL ──
  bnplPlanId        String?  // reference to BNPLPlan
  bnplPlan          BNPLPlan? @relation(fields: [bnplPlanId], references: [id])

  // ── Gift Wrap & Extras ──
  giftWrapSelected  Boolean @default(false)
  giftWrapPrice     Int @default(0) // in paise
  savingsAmount     Int @default(0) // total savings shown to customer

  // ── Shipping Intelligence ──
  shippingCost      Int?      // COD charge in ₹ paise (100 = ₹1)
  deliveryDate      DateTime? // Estimated delivery date from Shiprocket
  shippingProvider  String?   // "shiprocket" / "delhivery" / etc

  // Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  deviceType  String?   // mobile | desktop | tablet
  browserLang String?

  // Status
  status       String   @default("active")
  // active | completed | abandoned | recovered
  abandonedAt  DateTime?
  recoveredAt  DateTime?
  completedAt  DateTime?

  // Recovery tracking
  recoverySentAt   DateTime?
  recoveryAttempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([shopId, abandonedAt])
  @@index([phone])
  @@index([email])
  @@map("checkout_sessions")
}

// ─────────────────────────────────────────────────────────────
// ORDER — Order OS. Full order lifecycle.
// ─────────────────────────────────────────────────────────────
model Order {
  id         String  @id @default(cuid())
  shopId     String
  shop       Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Shopify identifiers
  shopifyOrderId   String
  shopifyOrderName String  // #1001

  // Order details
  totalPrice    Float
  subtotalPrice Float
  totalTax      Float  @default(0)
  totalDiscount Float  @default(0)
  currency      String @default("INR")
  paymentMethod String // cod | prepaid
  paymentStatus String @default("pending")
  // pending | paid | failed | refunded | partially_refunded
  items         Json   // OrderItem[]

  // Shipping
  shippingAddress Json?
  pincode         String?

  // Status (Order OS lifecycle)
  status      String @default("placed")
  // placed | confirmed | packed | dispatched | delivered | cancelled | returned

  // SLA tracking
  dispatchSlaAt  DateTime?  // must dispatch by
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  returnedAt     DateTime?

  // ── RTO Intelligence ──
  rtoRisk    Int     @default(0)
  isRTO      Boolean @default(false)
  rtoReason  String?
  rtoCost    Float?

  // ── Cancel Prevention ──
  cancelReason      String?
  cancelSaveAttempt Boolean @default(false)
  cancelSaved       Boolean @default(false)  // did we prevent the cancel?

  // ── COD Confirmation ──
  codConfirmationSent      Boolean @default(false)
  codConfirmationConfirmed Boolean @default(false)

  // ── Post-purchase Upsell ──
  upsellProductId String?
  upsellConverted Boolean @default(false)
  upsellRevenue   Float?

  // ── Promo Code & Loyalty ──
  promoCodeUsed        String?  // code that was applied
  promoDiscountAmount  Float @default(0)
  loyaltyPointsRedeemed Int @default(0)
  loyaltyDiscountAmount Float @default(0)
  loyaltyPointsEarned  Int @default(0)

  // ── BNPL ──
  bnplPlanId String?
  bnplPlan   BNPLPlan? @relation(fields: [bnplPlanId], references: [id])
  bnplSubscriptionId String? // Razorpay subscription ID

  // ── Gift Wrap & Extras ──
  giftWrapSelected Boolean @default(false)
  giftWrapPrice    Float @default(0)

  // Source
  sourceCheckoutToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments      Shipment[]
  returnRequests ReturnRequest[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, status])
  @@index([shopId, paymentMethod])
  @@index([customerId])
  @@index([shopId, createdAt])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────
// SHIPMENT — Shipping OS. Per-order tracking.
// ─────────────────────────────────────────────────────────────
model Shipment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  awb     String @unique // air waybill / tracking number
  carrier String // shiprocket | delhivery | bluedart | xpressbees | ecom | dtdc

  // Normalized status
  status    String @default("created")
  // created | in_transit | out_for_delivery | delivered
  // failed_delivery | rto_initiated | rto_delivered | exception
  rawStatus String? // carrier's original status string

  // Timestamps
  lastScannedAt     DateTime?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  // Exception detection
  isStuck        Boolean  @default(false)
  stuckSince     DateTime?
  failedAttempts Int      @default(0)
  lastFailedAt   DateTime?

  // RTO
  rtoInitiatedAt  DateTime?
  rtoDeliveredAt  DateTime?

  // NDR tracking
  lastNdrAt      DateTime? // last time an NDR message was sent
  ndrAttempts    Int       @default(0) // total NDR messages sent

  // Proactive comms sent
  dispatchNotifSent    Boolean @default(false)
  outForDeliveryNotif  Boolean @default(false)
  stuckNotifSent       Boolean @default(false)
  failedDeliveryNotif  Boolean @default(false)
  rtoInterventionSent  Boolean @default(false)

  // Tracking history
  trackingEvents Json @default("[]") // TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([carrier])
  @@index([isStuck])
  @@map("shipments")
}

// ─────────────────────────────────────────────────────────────
// COMMUNICATION — Communication OS. Every message ever sent.
// ─────────────────────────────────────────────────────────────
model Communication {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Message details
  channel   String // whatsapp | email | sms
  direction String // outbound | inbound
  messageId String? // external ID (WATI, SendGrid, Twilio)

  // Content
  templateName String?
  subject      String?  // email only
  body         String

  // What triggered this message
  triggerType String
  triggerRef  String?  // orderId, checkoutId, shipmentId, etc.

  // Delivery status
  status String @default("queued")
  // queued | sent | delivered | opened | clicked | replied | failed | bounced

  // Timestamps
  queuedAt    DateTime @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  repliedAt   DateTime?
  failedAt    DateTime?

  // Reply handling
  replyBody     String?
  replyHandled  Boolean @default(false)
  routedToAgent Boolean @default(false)

  createdAt DateTime @default(now())

  // Outcome tracking — the feedback loop
  outcomeRef  String?   @unique  // UUID set at send time, used to close the loop
  outcome     String?            // converted | replied | ignored | blocked | delivered | failed
  outcomeAt   DateTime?

  @@index([shopId, customerId])
  @@index([shopId, triggerType])
  @@index([shopId, status])
  @@index([shopId, channel])
  @@map("communications")
}

// ─────────────────────────────────────────────────────────────
// SUPPORT TICKET — Support OS.
// ─────────────────────────────────────────────────────────────
model SupportTicket {
  id         String   @id @default(cuid())
  shopId     String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Ticket meta
  channel  String  // whatsapp | email | widget | instagram
  intent   String  // wismo | cancel | return | wrong_item | payment | product_q | exchange | other
  priority String  @default("normal") // low | normal | high | urgent

  // Is this VIP customer?
  isVip Boolean @default(false)

  // Conversation (append-only log)
  conversation Json @default("[]")
  // [{ role: "customer"|"claude"|"agent", content, timestamp, confidence? }]

  // Resolution
  status     String @default("open")
  // open | in_progress | resolved | escalated | closed
  resolvedBy String? // claude | human_agent
  resolution String?

  // Escalation
  escalatedAt     DateTime?
  escalationReason String?
  assignedAgentId  String?

  // CSAT
  csatScore    Int?    // 1-5
  csatFeedback String?
  csatAskedAt  DateTime?

  // Timing
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  openedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([customerId])
  @@index([shopId, intent])
  @@index([shopId, priority])
  @@map("support_tickets")
}

// ─────────────────────────────────────────────────────────────
// RETENTION ACTION — Retention OS. Scheduled actions per customer.
// ─────────────────────────────────────────────────────────────
model RetentionAction {
  id         String   @id @default(cuid())
  shopId     String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  actionType String
  // repurchase_nudge | churn_intervention | win_back
  // vip_reward | referral_ask | review_request | upsell

  scheduledFor DateTime
  executedAt   DateTime?

  status String @default("scheduled")
  // scheduled | executing | executed | skipped | cancelled | failed

  // Outcome
  converted       Boolean @default(false)
  conversionValue Float?
  communicationId String? // which message was sent

  metadata Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status, scheduledFor])
  @@index([customerId])
  @@map("retention_actions")
}

// ─────────────────────────────────────────────────────────────
// TIMELINE EVENT — Per customer, full history for merchant view.
// ─────────────────────────────────────────────────────────────
model TimelineEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  shopId     String

  eventType   String  // maps to EventType enum in shared
  title       String  // "Order #1042 placed — ₹1,200"
  description String?
  metadata    Json    @default("{}")

  occurredAt DateTime @default(now())

  @@index([customerId, occurredAt])
  @@index([shopId, occurredAt])
  @@map("timeline_events")
}

// ─────────────────────────────────────────────────────────────
// AUTOMATION — Merchant-configured flows.
// ─────────────────────────────────────────────────────────────
model Automation {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name     String
  trigger  String   // checkout.abandoned | order.placed | shipment.delivered | etc.
  isActive Boolean  @default(true)

  // Flow definition
  steps Json
  // [{ delay: 900, channel: "whatsapp", templateName: "...", condition?: {...} }]

  // Stats
  totalTriggered Int @default(0)
  totalExecuted  Int @default(0)
  totalConverted Int @default(0)
  revenue        Float @default(0)  // revenue attributed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, trigger])
  @@index([shopId, isActive])
  @@map("automations")
}

// ─────────────────────────────────────────────────────────────
// OTP CODE — Postgres-backed OTP store. Replaces in-memory Map.
// Multi-instance safe. Auto-expires.
// ─────────────────────────────────────────────────────────────
model OtpCode {
  id        String   @id @default(cuid())
  shopId    String
  phone     String   // normalized 10-digit
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([shopId, phone])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ─────────────────────────────────────────────────────────────
// WHATSAPP SESSION — Conversation state for Customer Agent.
// Enables multi-turn, context-aware conversations.
// ─────────────────────────────────────────────────────────────
model WhatsAppSession {
  id         String  @id @default(cuid())
  shopId     String
  phone      String  // customer's normalized phone
  customerId String?

  // Current agent state
  currentIntent String?
  // cancel | return | address_change | order_status | complaint | ndr_response | cod_confirm

  contextJson Json @default("{}")
  // { orderId, step, pendingAction, data, ... }

  // Full conversation history for agent context
  history Json @default("[]")
  // [{ role: "user"|"assistant", content: string, timestamp: string }]

  lastMessageAt DateTime @default(now())
  expiresAt     DateTime // 24h from lastMessageAt, reset on each message

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, phone])
  @@index([shopId, phone])
  @@index([expiresAt])
  @@map("whatsapp_sessions")
}

// ─────────────────────────────────────────────────────────────
// RETURN REQUEST — Returns OS. Customer-initiated return flow.
// ─────────────────────────────────────────────────────────────
model ReturnRequest {
  id         String  @id @default(cuid())
  shopId     String
  shop       Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // What's being returned
  items          Json    // ReturnItem[] — { title, quantity, price, reason }
  reason         String  // quality | wrong_item | not_needed | damaged | size | other
  reasonNote     String? // customer's own words
  refundMethod   String  // original_payment | store_credit | bank_transfer
  refundAmount   Float

  // Photos (customer uploads via presigned URL or base64 links)
  photoUrls      Json    @default("[]") // string[]

  // Status lifecycle
  status         String  @default("pending")
  // pending | approved | rejected | pickup_scheduled | picked_up | processed | refunded

  // Merchant action
  rejectionReason String?
  approvedAt      DateTime?
  rejectedAt      DateTime?

  // Shiprocket reverse pickup
  shiprocketOrderId   String?
  pickupScheduledAt   DateTime?
  pickedUpAt          DateTime?

  // Refund tracking
  refundInitiatedAt   DateTime?
  refundCompletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status])
  @@index([orderId])
  @@index([customerId])
  @@map("return_requests")
}

// ─────────────────────────────────────────────────────────────
// MARKETING EVENT — Marketing OS. Server-side events log.
// ─────────────────────────────────────────────────────────────
model MarketingEvent {
  id         String  @id @default(cuid())
  shopId     String
  customerId String?

  platform  String  // meta | google
  eventName String  // Purchase | AddToCart | InitiateCheckout | custom
  eventValue Float?

  // Deduplication
  eventId   String  // sent to Meta/Google for dedup
  firedAt   DateTime @default(now())
  success   Boolean  @default(true)
  error     String?

  metadata Json @default("{}")

  @@index([shopId, eventName])
  @@index([shopId, firedAt])
  @@map("marketing_events")
}

// ─────────────────────────────────────────────────────────────
// PROMO CODE — Discount codes/coupons for checkout
// ─────────────────────────────────────────────────────────────
model PromoCode {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  code String @unique // "SAVE20"
  discountType String // "percentage" | "fixed"
  discountValue Float // 20 for 20%, or 500 for ₹500
  maxRedemptions Int? // null = unlimited
  redemptions Int @default(0)

  // Eligibility
  minOrderValue Float? // minimum cart value
  maxUsesPerCustomer Int @default(1)
  applicableOnFirstOrder Boolean @default(false)

  // Dates
  validFrom DateTime
  validUntil DateTime

  createdAt DateTime @default(now())

  @@index([shopId, code])
  @@map("promo_codes")
}

// ─────────────────────────────────────────────────────────────
// LOYALTY PROGRAM — Shop-level loyalty settings
// ─────────────────────────────────────────────────────────────
model LoyaltyProgram {
  id String @id @default(cuid())
  shopId String @unique
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  pointsPerRupee Float @default(1.0) // 1 point per ₹1 spent
  pointsExpiryDays Int? // null = never expire
  redeemPointsValue Float @default(100) // 100 points = ₹100
  minimumPointsToRedeem Int @default(100)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loyalty_programs")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMER LOYALTY POINTS — Track customer points balance
// ─────────────────────────────────────────────────────────────
model CustomerLoyaltyPoints {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  totalPoints Float @default(0)
  redeemedPoints Float @default(0)
  availablePoints Float @default(0)
  lastPointsAddedAt DateTime?
  lastPointsRedeemedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_loyalty_points")
}

// ─────────────────────────────────────────────────────────────
// BNPL / INSTALLMENT PLANS — Buy Now Pay Later options
// ─────────────────────────────────────────────────────────────
model BNPLPlan {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name String // "3 Months @ 0% interest"
  months Int
  interestRate Float @default(0)
  minOrderValue Float @default(2500)
  maxOrderValue Float?

  provider String @default("razorpay") // razorpay | jio | other
  razorpayPlanId String? // Razorpay plan ID for subscriptions

  enabled Boolean @default(true)

  checkoutSessions CheckoutSession[]
  orders Order[]

  createdAt DateTime @default(now())

  @@index([shopId])
  @@map("bnpl_plans")
}

// ─────────────────────────────────────────────────────────────
// AGENT DECISIONS — Phase 5 Orchestration Audit Trail
// ─────────────────────────────────────────────────────────────
// Every decision made by any agent is recorded here.
// This enables:
// - Audit trail (merchant can see why an action happened)
// - Learning loop (outcomes feed back to improve decisions)
// - Conflict resolution tracking (how often do agents conflict?)
// - Performance metrics (which agents have highest success rates?)
model AgentDecision {
  id String @id @default(cuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Agent identity
  agentDomain String // "support" | "operations" | "logistics" | "finance" | "marketing"
  agentName String // e.g., "abandoned-cart", "ndr", "loyalty"

  // Decision details
  action String // e.g., "send_message", "block_cod", "escalate_to_human"
  reasoning String // why the agent made this decision
  context Json? // additional context (discount %, retry count, etc.)
  confidence Int // 0-100, how sure is the agent?
  priority String // "low" | "medium" | "high"

  // Orchestrator evaluation
  orchestratorReason String? // why orchestrator approved/rejected
  overrides Json? // rules applied by orchestrator (JSON array)
  conflicts Json? // conflicts resolved (JSON array)

  // Execution
  status String @default("pending") // pending | queued | executing | executed | failed | rejected
  idempotencyKey String @unique // prevent duplicate execution
  executeAt DateTime? // when should this execute?
  queuedAt DateTime? // when was it queued?
  executedAt DateTime? // when was it actually executed?
  result Json? // what happened when it executed?
  error String? // error message if execution failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningOutcomes LearningOutcome[]
  agentFeedback    AgentFeedback[]

  @@index([customerId])
  @@index([agentDomain])
  @@index([status])
  @@index([createdAt])
  @@map("agent_decisions")
}

// ─────────────────────────────────────────────────────────────
// LEARNING OUTCOMES — Outcome Tracking for Learning Loop
// ─────────────────────────────────────────────────────────────
// Every decision's outcome is recorded here for fast querying and analysis.
// This feeds the learning loop: agents get better over time as outcomes improve.
model LearningOutcome {
  id String @id @default(cuid())
  decisionId String
  decision AgentDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  agentDomain String
  agentName String
  action String

  outcome String // "success" | "partial" | "failure"
  confidence Int? // agent's confidence (0-100) at time of decision
  metadata Json? // additional context (e.g., conversion time, customer segment)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([agentDomain])
  @@index([outcome])
  @@index([createdAt])
  @@map("learning_outcomes")
}

// ─────────────────────────────────────────────────────────────
// AGENT FEEDBACK — Merchant Overrides for Training
// ─────────────────────────────────────────────────────────────
// When merchants override an agent decision, we record it as training data.
// "Merchant said NO, but agent said YES" → improves future decisions.
model AgentFeedback {
  id String @id @default(cuid())
  decisionId String
  decision AgentDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  agentDomain String
  merchantDecision String // "approved" | "overridden" | "escalated"
  merchantReason String?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([agentDomain])
  @@index([createdAt])
  @@map("agent_feedback")
}

// ─────────────────────────────────────────────────────────────
// EARLY ADOPTER — Marketing Site Signup & Waitlist
// ─────────────────────────────────────────────────────────────
// Tracks early adopter signups for marketing site.
// Used for waitlist queue, referral tracking, beta onboarding.
model EarlyAdopter {
  id              String    @id @default(cuid())
  email           String    @unique
  companyName     String
  productCategory String
  shopifyStore    String
  expectedOrders  Int
  referralCode    String    @unique @default(cuid())
  referralCount   Int       @default(0)
  referredBy      String?   // Email of referrer
  rank            Int?      // Position in waitlist (updated when referrals move them up)
  status          String    @default("waitlist") // waitlist | approved | onboarded | churned
  signupSource    String?   // "organic" | "referral" | "ads"

  // Email tracking
  lastEmailAt     DateTime?
  emailsSent      Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  referrals       EarlyAdopter[] @relation("Referrals")
  referredByUser  EarlyAdopter? @relation("Referrals", fields: [referredBy], references: [email])

  @@index([email])
  @@index([status])
  @@index([rank])
  @@index([referralCode])
  @@index([createdAt])
  @@map("early_adopters")
}

// ─────────────────────────────────────────────────────────────
// EMAIL LOG — Track Marketing Email Sends
// ─────────────────────────────────────────────────────────────
// For monitoring email delivery and bounce rates.
model EmailLog {
  id        String   @id @default(cuid())
  email     String
  type      String   // signup_confirmation | weekly_rank | referral_bonus | onboarding_ready
  status    String   // sent | failed | bounced | opened | clicked
  messageId String?  // Resend message ID for tracking
  createdAt DateTime @default(now())

  @@index([email])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}
